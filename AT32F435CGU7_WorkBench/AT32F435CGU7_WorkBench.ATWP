        <MCUName>AT32F435CGU7</MCUName>
        <MCUPackage>QFN48</MCUPackage>
    </MCUInfo>
    <CRM>
        <Mode>
            <ModeSub name="HEXT" value="HEXT-External-Oscillator"/>
