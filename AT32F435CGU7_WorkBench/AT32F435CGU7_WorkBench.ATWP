            <ModeSub name="Mode" value="Asynchronous"/>
        </Mode>
        <Parameters>
            <ParametersSub name="BaudRate" value="921600"/>
            <ParametersSub name="RealBaudRate" value="923077"/>
        </Parameters>
    </USART1>
